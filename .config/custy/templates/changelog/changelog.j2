{#
Custy changelog template.

The template consumes only the documented ChangelogRenderContext
API. All model normalization happens in Python so missing domain
attributes fail loudly instead of silently producing empty sections.
#}
{% set render = context.config.rendering %}
{% set releases = context.visible_releases() %}

{% macro render_item(item) -%}
{{ " " * render.indent }}{{ render.bullet }} {{ item }}
{%- endmacro %}

{% macro render_group(group) %}
### {{ group.title }}

{% for item in group.items %}
{{ render_item(item) }}
{% endfor %}
{% for subsection in group.subsections %}
#### {{ subsection.title }}

{% for item in subsection.items %}
{{ render_item(item) }}
{% endfor %}
{% endfor %}
{% endmacro %}

{% if render.show_title %}
# 🧾 Changelog
{% endif %}
{% if render.show_description %}
All notable changes to this project are documented in this file.

This changelog is automatically generated by Custy from structured commit messages.
{% endif %}
{% for release in releases %}
## {{ release.version }}{% if release.release_date %} ({{ release.release_date }}){% endif %}

{% if render.show_compare_link and release.compare_url %}
🔗 Compare:
{{ release.compare_url }}
{% endif %}
{% if not release.title_only %}
{% if render.show_release_status and release.status %}
**Release**
{{ context.release_label(release) }}
{% endif %}
{% set summary = context.summary_for(release) %}
{% if render.show_summary and (summary or (render.show_promoted_from and release.promoted_from)) %}
**Summary**

{% if summary %}
{{ summary }}
{% endif %}
{% if render.show_promoted_from and release.promoted_from %}
Promoted from:

{% for version in release.promoted_from %}
{{ render_item(version) }}
{% endfor %}
{% endif %}
{% elif render.show_promoted_from and release.promoted_from %}
**Promoted From**

{% for version in release.promoted_from %}
{{ render_item(version) }}
{% endfor %}
{% endif %}
{% for group in context.groups_for(release) %}
{{ render_group(group) }}
{% endfor %}
{% set tags = context.tags_for(release) %}
{% if render.show_tags and (tags or render.show_empty_tags) %}
**Tags**

{{ tags | join(" • ") }}
{% endif %}
{% endif %}
{% endfor %}
{% if render.show_footer %}
---

Generated by **Custy**
{% endif %}
