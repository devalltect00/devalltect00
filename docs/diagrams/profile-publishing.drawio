<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Approved profile publication" id="profile-publish"><mxGraphModel page="1" pageWidth="1200" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" value="Owner confirms approved active distributed release + reviewed public profile repository&#10;Fixed provider API / main / README.md; browser Origin + CSRF; Editors cannot publish" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="35" width="1060" height="105" /></mxCell><mxCell id="3" parent="1" value="Short SQL transaction: locked Owner + workspace + one current target attempt&#10;Three lifetime claims maximum; unresolved admitted writes cannot be replaced" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="180" width="1060" height="105" /></mxCell><mxCell id="e3" parent="1" edge="1" source="2" target="3" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="4" parent="1" value="Outside SQL: GET reviewed public numeric repository identity and exact README revision&#10;Go selects explicit channel projects + literal skills + summary; escapes all author text" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="325" width="1060" height="105" /></mxCell><mxCell id="e4" parent="1" edge="1" source="3" target="4" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="5" parent="1" value="Replace only summary / toolkit / projects bodies; preserve every outside byte&#10;Exact marker pairs + consistent monotonic release identity; empty content clears old output" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="470" width="1060" height="105" /></mxCell><mxCell id="e5" parent="1" edge="1" source="4" target="5" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="6" parent="1" value="Short SQL transaction: repeat current authority and generator&#10;Retain original compare revision + before/after/plan hashes, never full README bodies" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="615" width="1060" height="105" /></mxCell><mxCell id="e6" parent="1" edge="1" source="5" target="6" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="7" parent="1" value="At most one conditional provider PUT outside SQL; exact no-op sends no commit&#10;GitHub blob SHA / GitLab last commit ID; no automatic retry or rebase" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="760" width="1060" height="105" /></mxCell><mxCell id="e7" parent="1" edge="1" source="6" target="7" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="8" parent="1" value="Fresh complete-file GET: expected full SHA-256 + exact generated regions&#10;Atomic SQL receipt + this target success + aggregate state + audit; other jobs unchanged" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="905" width="1060" height="105" /></mxCell><mxCell id="e8" parent="1" edge="1" source="7" target="8" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="9" parent="1" value="Read-only public CI checks marker templates; activity/snake automation stays separate&#10;No production copy, token, remote commit, push or deployment is enabled by this local implementation" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="1050" width="1060" height="105" /></mxCell><mxCell id="e9" parent="1" edge="1" source="8" target="9" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram name="Alternative recovery outcomes" id="profile-recovery"><mxGraphModel page="1" pageWidth="1520" pageHeight="1030"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="inspect" parent="1" value="Owner refreshes durable current source / attempt / target progress&#10;These three outcomes are alternatives" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="60" y="25" width="1390" height="100" /></mxCell><mxCell id="c0-0" parent="1" value="Preparation never admitted a write&#10;OR trusted provider explicitly rejected it" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="60" y="190" width="440" height="180" /></mxCell><mxCell id="inspect-c0-0" parent="1" edge="1" source="inspect" target="c0-0" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c0-1" parent="1" value="Retain failure/rejection + audit&#10;Review template, credentials and concurrent edits&#10;Separate fresh UUID only if budget remains" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="60" y="435" width="440" height="180" /></mxCell><mxCell id="c0-0-c0-1" parent="1" edge="1" source="c0-0" target="c0-1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c0-2" parent="1" value="Three lifetime claims maximum&#10;No deletion, counter reset or automatic rebase" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="60" y="680" width="440" height="180" /></mxCell><mxCell id="c0-1-c0-2" parent="1" edge="1" source="c0-1" target="c0-2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c1-0" parent="1" value="Write admitted; outcome uncertain&#10;Timeout / rate limit / 5xx / lost acknowledgement" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="535" y="190" width="440" height="180" /></mxCell><mxCell id="inspect-c1-0" parent="1" edge="1" source="inspect" target="c1-0" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c1-1" parent="1" value="After the two-minute lease, confirm GET-only reconciliation&#10;Exact retained full-file hash + generated regions + current Owner/source/target" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="535" y="435" width="440" height="180" /></mxCell><mxCell id="c1-0-c1-1" parent="1" edge="1" source="c1-0" target="c1-1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c1-2" parent="1" value="Exact match: atomic receipt and target-only success&#10;No match: preserve hold for investigation&#10;Never resend the admitted write" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="535" y="680" width="440" height="180" /></mxCell><mxCell id="c1-1-c1-2" parent="1" edge="1" source="c1-1" target="c1-2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c2-0" parent="1" value="Delivery already completed&#10;Immutable historical receipt retained" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="1010" y="190" width="440" height="180" /></mxCell><mxCell id="inspect-c2-0" parent="1" edge="1" source="inspect" target="c2-0" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c2-1" parent="1" value="Exact completed replay performs no provider request&#10;A changed target policy does not inherit old proof" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="1010" y="435" width="440" height="180" /></mxCell><mxCell id="c2-0-c2-1" parent="1" edge="1" source="c2-0" target="c2-1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c2-2" parent="1" value="Not continuous drift monitoring&#10;Manual rollback or later edits require separate review" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="1010" y="680" width="440" height="180" /></mxCell><mxCell id="c2-1-c2-2" parent="1" edge="1" source="c2-1" target="c2-2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="limits" parent="1" value="Original compare base, immutable history and unresolved-write ordering are preserved&#10;No fake consumer success, forced rollback, live deployment or credential change is authorized by this local workflow" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontSize=16;"><mxGeometry as="geometry" x="60" y="935" width="1390" height="80" /></mxCell></root></mxGraphModel></diagram></mxfile>